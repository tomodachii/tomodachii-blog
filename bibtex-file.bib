  doi = {10.48550/arXiv.2004.08697},
  urldate = {2025-09-18},
  abstract = {Learning disentanglement aims at finding a low dimensional representation which consists of multiple explanatory and generative factors of the observational data. The framework of variational autoencoder (VAE) is commonly used to disentangle independent factors from observations. However, in real scenarios, factors with semantics are not necessarily independent. Instead, there might be an underlying causal structure which renders these factors dependent. We thus propose a new VAE based framework named CausalVAE, which includes a Causal Layer to transform independent exogenous factors into causal endogenous ones that correspond to causally related concepts in data. We further analyze the model identifiabitily, showing that the proposed model learned from observations recovers the true one up to a certain degree by providing supervision signals (e.g. feature labels). Experiments are conducted on various datasets, including synthetic and real word benchmark CelebA. Results show that the causal representations learned by CausalVAE are semantically interpretable, and their causal relationship as a Directed Acyclic Graph (DAG) is identified with good accuracy. Furthermore, we demonstrate that the proposed CausalVAE model is able to generate counterfactual data through "do-operation" to the causal factors.},
  archiveprefix = {arXiv},
  keywords = {computer-science,machine-learning,statistics},
  file = {C\:\\Users\\Admin\\Zotero\\storage\\LNEKPKGQ\\Yang et al. - 2023 - CausalVAE Structured Causal Disentanglement in Variational Autoencoder.pdf;C\:\\Users\\Admin\\Zotero\\storage\\6BPWNY98\\2004.html}
}

@misc{zantedeschiDAGLearningPermutahedron2023,
